{
  "moving_major_tag": false,
  "version_files": [
    {
      "path": "local/share/check_mk/agents/plugins/oposs_ceph",
      "pattern": "^PLUGIN_VERSION=\"[^\"]*\"",
      "replacement": "PLUGIN_VERSION=\"$VERSION\"",
      "verify": "^PLUGIN_VERSION=\"$VERSION\""
    },
    {
      "path": "local/lib/python3/cmk_addons/plugins/oposs_ceph/agent_based/oposs_ceph.py",
      "pattern": "^__version__ = \"[^\"]*\"",
      "replacement": "__version__ = \"$VERSION\"",
      "verify": "^__version__ = \"$VERSION\""
    }
  ],
  "release_assets": [
    "oposs_ceph-*.mkp"
  ]
}
