#!/bin/bash
# Agent plugin for Ceph cluster monitoring
# Collects status, OSD performance, and pool usage data

# Create release PR writes the released version here (version_files in
# .github/repo-infra.json)
PLUGIN_VERSION="unreleased"

CEPH=${CEPH_CMD:-ceph}
# Seconds each ceph call may take; it hangs when no monitor answers
CEPH_TIMEOUT=${CEPH_TIMEOUT:-30}

echo "<<<oposs_ceph_status:sep(0)>>>"
timeout "$CEPH_TIMEOUT" $CEPH status -f json 2>/dev/null

echo "<<<oposs_ceph_osd_perf:sep(0)>>>"
timeout "$CEPH_TIMEOUT" $CEPH osd perf -f json 2>/dev/null

echo "<<<oposs_ceph_df:sep(0)>>>"
timeout "$CEPH_TIMEOUT" $CEPH df detail -f json 2>/dev/null
